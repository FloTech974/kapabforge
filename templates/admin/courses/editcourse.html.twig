{% extends 'admin/base.html.twig' %}

{% block title %}{{ parent() }}Modifier une formation{% endblock %}

{% block body %}
<section class="w-full max-w-md mx-auto px-4 py-8">
  <h1 class="text-3xl font-normal">Modifier la formation</h1>
  <a href="{{ path('app_admin_courses') }}" class="btn btn-ghost my-4"> {{ ux_icon('ep:back') }} Retour à la liste</a>
  <div class="rounded-xl bg-base-300 p-6 [&_.input]:w-full [&_.select]:w-full [&_.textarea]:w-full">
    {{ form_start(form) }}
      {{ form_widget(form) }}
      <button class="w-full btn btn-primary">Modifier</button>
    {{ form_end(form) }}
  </div>
</section>
{% endblock %}