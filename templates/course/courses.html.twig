{% extends 'base.html.twig' %}

{% block title %}{{parent() }}Formations{% endblock %}

{% block body %}
<section class="container px-4 py-10 max-w-6xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Nos Formations</h1>

    {{ render(controller(
        'App\\Controller\\CategoryController::categories',
        {current: app.request.attributes.get('slug')}
    )) }}

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for course in courses %}
            {% include 'partials/course_card.html.twig' %}
        {% else %}
            <p>Aucune formation disponible pour le moment.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
