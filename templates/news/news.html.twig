{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Actualités{% endblock %}

{% block body %}
<section class="container px-4 py-10 max-w-6xl mx-auto">
  <h1 class="text-3xl font-bold mb-6">Actualités</h1>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for item in news %}
      {% include 'partials/news_card.html.twig' %}
    {% else %}
      <p>Aucune actualité pour le moment.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
